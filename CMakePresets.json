{
  "version": 2,
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "pr_pipeline",
      "displayName": "PR Pipeline",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fprofile-instr-generate -fcoverage-mapping -g -O0 -Wno-deprecated-declarations",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping -g -O0 -Wno-deprecated-declarations"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "pr_pipeline",
      "displayName": "PR Pipeline Artifacts",
      "configurePreset": "pr_pipeline",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "test_pr_pipeline_coverage",
      "configurePreset": "pr_pipeline",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test_pr_pipeline_spark_coverage",
      "configurePreset": "pr_pipeline",
      "filter": {
        "exclude": {
          "name": "Databricks"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test_pr_pipeline_databricks_coverage",
      "configurePreset": "pr_pipeline",
      "filter": {
        "exclude": {
          "name": "Spark"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}